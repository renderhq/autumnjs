{
  "name": "@autumnjs/core",
  "version": "1.0.0",
  "description": "The high-performance reactive engine powering the Autumn ecosystem.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./jsx-runtime": {
      "import": "./dist/jsx-runtime.js",
      "types": "./dist/jsx-runtime.d.ts"
    },
    "./reactivity": {
      "import": "./dist/reactivity.js",
      "types": "./dist/reactivity.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    },
    "./components": {
      "import": "./dist/components.js",
      "types": "./dist/components.d.ts"
    },
    "./store": {
      "import": "./dist/store.js",
      "types": "./dist/store.d.ts"
    },
    "./lifecycle": {
      "import": "./dist/lifecycle.js",
      "types": "./dist/lifecycle.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./grid": {
      "import": "./dist/grid.js",
      "types": "./dist/grid.d.ts"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/jsx-runtime.ts reactivity=src/reactivity/index.ts runtime=src/runtime/index.ts components=src/components/index.ts store=src/store/index.ts lifecycle=src/lifecycle/index.ts utils=src/utils/index.ts grid=src/grid/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/jsx-runtime.ts reactivity=src/reactivity/index.ts runtime=src/runtime/index.ts components=src/components/index.ts store=src/store/index.ts lifecycle=src/lifecycle/index.ts utils=src/utils/index.ts grid=src/grid/index.ts --format esm --dts --watch --clean"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "comlink": "^4.4.2",
    "preact": "^10.28.2",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "reactive",
    "engine",
    "signals",
    "autumn",
    "javascript",
    "typescript",
    "frontend",
    "ui",
    "components",
    "state-management",
    "performance",
    "web",
    "browser",
    "jsx",
    "reactive-programming",
    "bun",
    "bun-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/renderhq/autumnjs.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/renderhq/autumnjs/issues"
  },
  "homepage": "https://github.com/renderhq/autumnjs#readme",
  "author": "Autumn Team <https://x.com/infinterenders>",
  "license": "MIT"
}
